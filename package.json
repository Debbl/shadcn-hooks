{
  "name": "shadcn-hooks-monorepo",
  "version": "0.0.7",
  "private": true,
  "description": "shadcn hooks",
  "homepage": "https://github.com/Debbl/shadcn-hooks",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://github.com/Debbl/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Debbl/shadcn-hooks.git"
  },
  "type": "module",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "next dev",
    "preflight": "tsx scripts/preflight.ts",
    "test": "vitest",
    "release": "bumpp -r",
    "build": "tsx scripts/build.ts",
    "build:shadcn-hooks": "pnpm --filter shadcn-hooks build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "start:worker": "wrangler dev",
    "typecheck": "next typegen && tsc --noEmit && pnpm typecheck:worker",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:links": "tsx scripts/check-links.ts",
    "typecheck:worker": "tsc --project tsconfig.worker.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@debbl/ahooks": "^0.4.1",
    "@next/third-parties": "^16.3.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dequal": "^2.0.3",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "^1.52.0",
    "fumadocs-core": "^16.15.10",
    "fumadocs-docgen": "^3.1.0",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.10",
    "glob": "^13.0.6",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.45.0",
    "mdast-util-mdxjs-esm": "^2.0.1",
    "motion": "^13.2.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "npm-to-yarn": "^3.2.0",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "react-use-measure": "^2.1.7",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwindcss-animate": "^1.0.7",
    "tinyexec": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "twl": "^0.2.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@debbl/oxc-config": "^0.0.5",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/estree": "^1.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.11.23",
    "bumpp": "^12.3.0",
    "consola": "^3.4.2",
    "esbuild": "^0.28.2",
    "fumadocs-typescript": "^5.4.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "mdast-util-mdx-jsx": "^3.2.0",
    "next-auto-import": "^0.0.4",
    "next-validate-link": "^1.6.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "postcss": "^8.5.28",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "shadcn": "^4.21.0",
    "simple-git-hooks": "^2.14.0",
    "swc-plugin-auto-import": "^0.0.7",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1",
    "zod": "^4.6.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,json5,css,scss,html,md,mdx,yaml,yml}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@12.4.1"
}
