{
  "name": "shadcn-hooks",
  "version": "0.0.7",
  "description": "shadcn hooks",
  "keywords": [
    "ahooks",
    "hooks",
    "react",
    "react-hooks-ts",
    "react-use",
    "shadcn"
  ],
  "homepage": "https://github.com/Debbl/shadcn-hooks#readme",
  "bugs": "https://github.com/Debbl/shadcn-hooks/issues",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/shadcn-hooks.git",
    "directory": "packages/shadcn-hooks"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node ./src/index.ts",
    "build": "tsdown",
    "test": "vitest",
    "sync": "pnpm dlx shadcn@latest add @shadcnhooks/all --overwrite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "dequal": "^2.0.3",
    "es-toolkit": "^1.52.0",
    "swr": "^2.5.1",
    "use-mcp": "^0.0.21",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "shadcn": "^4.21.0",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "packageManager": "pnpm@12.4.1"
}
