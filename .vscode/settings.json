{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "json.schemas": [
    {
      "fileMatch": ["registry-item.json"],
      "url": "./schema/registry-item.json"
    }
  ],
  "cSpell.words": [
    "dequal",
    "fumadocs",
    "lingui",
    "mdast",
    "nextui",
    "nuqs",
    "opengraph",
    "orama",
    "precache",
    "serwist",
    "shadcn",
    "tinyexec",
    "turbopack"
  ]
}
